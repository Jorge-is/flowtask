meta {
  name: Crear tarea
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: none
}

body:json {
  {
    "title": "Preparar informe mensual",
    "description": "Consolidar el avance del equipo",
    "due_date": "{{dueDate}}",
    "category_id": {{categoryId}}
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
  res.body.status: eq Pendiente
  res.body.category.name: eq Trabajo
}

script:post-response {
  bru.setVar("taskId", res.getBody().id);
}
