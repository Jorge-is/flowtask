meta {
  name: Crear con estado inválido (422)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: none
}

body:json {
  {
    "title": "Tarea con estado inválido",
    "status": "Archivada",
    "due_date": "{{dueDate}}",
    "category_id": {{categoryId}}
  }
}

assert {
  res.status: eq 422
}
